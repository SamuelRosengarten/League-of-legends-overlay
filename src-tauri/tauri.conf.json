{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL Overlay",
  "version": "0.2.0",
  "identifier": "com.samuelrosengarten.lol-overlay",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "LoL Overlay",
        "url": "index.html",
        "width": 320,
        "height": 420,
        "x": 20,
        "y": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
